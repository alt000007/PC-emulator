<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless companion for development and CI: runs the real phone API with an in-memory
    simulated Sunshine on any OS, opens a pairing window and prints the pairing link.
    The Android interop tests pair against it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PocketPC.Core\PocketPC.Core.csproj" />
  </ItemGroup>

</Project>
